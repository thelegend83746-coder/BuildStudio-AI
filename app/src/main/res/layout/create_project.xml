<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <LinearLayout
      android:id="@+id/linear1"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/bg_slate_50"
      android:orientation="vertical"
      android:padding="16.0dp">

    <TextView
        android:id="@+id/textview1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8.0dp"
        android:text="Choose Template"
        android:textColor="@color/text_slate_900"
        android:textSize="22.0sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/vscroll2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

      <LinearLayout
          android:id="@+id/main"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <!-- STEP 1: CHOOSE TEMPLATE -->
        <LinearLayout
            android:id="@+id/choose_template_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <LinearLayout
              android:id="@+id/linear11"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">

            <!-- Row 1: Simple & FAB -->
            <LinearLayout
                android:id="@+id/linear12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12.0dp"
                android:orientation="horizontal">

              <!-- Template 1: Simple App -->
              <LinearLayout
                  android:id="@+id/template_1_button"
                  android:layout_width="0.0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:clickable="true"
                  android:focusable="true"
                  android:gravity="center"
                  android:orientation="vertical"
                  android:padding="10.0dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16.0dp"
                    app:cardElevation="3.0dp"
                    app:contentPadding="4.0dp">
                  <ImageView
                      android:id="@+id/template_1"
                      android:layout_width="match_parent"
                      android:layout_height="120.0dp"
                      android:scaleType="fitCenter"
                      android:src="@drawable/activity_0001" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textview2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:text="Simple App"
                    android:textColor="@color/text_slate_900"
                    android:textSize="14.0sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dp"
                    android:gravity="center"
                    android:text="Clean single Activity with basic UI"
                    android:textColor="@color/text_slate_500"
                    android:textSize="11.0sp" />
              </LinearLayout>

              <View
                  android:layout_width="8.0dp"
                  android:layout_height="wrap_content" />

              <!-- Template 2: FAB App -->
              <LinearLayout
                  android:id="@+id/template_2_button"
                  android:layout_width="0.0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:clickable="true"
                  android:focusable="true"
                  android:gravity="center"
                  android:orientation="vertical"
                  android:padding="10.0dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16.0dp"
                    app:cardElevation="3.0dp"
                    app:contentPadding="4.0dp">
                  <ImageView
                      android:id="@+id/template_2"
                      android:layout_width="match_parent"
                      android:layout_height="120.0dp"
                      android:scaleType="fitCenter"
                      android:src="@drawable/activity_1001" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textview3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:text="FAB App"
                    android:textColor="@color/text_slate_900"
                    android:textSize="14.0sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dp"
                    android:gravity="center"
                    android:text="Floating Action Button &amp; Coordinator"
                    android:textColor="@color/text_slate_500"
                    android:textSize="11.0sp" />
              </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Navigation Drawer & Fullscreen -->
            <LinearLayout
                android:id="@+id/linear13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

              <!-- Template 3: Navigation Drawer -->
              <LinearLayout
                  android:id="@+id/template_3_button"
                  android:layout_width="0.0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:clickable="true"
                  android:focusable="true"
                  android:gravity="center"
                  android:orientation="vertical"
                  android:padding="10.0dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16.0dp"
                    app:cardElevation="3.0dp"
                    app:contentPadding="4.0dp">
                  <ImageView
                      android:id="@+id/imageview1"
                      android:layout_width="match_parent"
                      android:layout_height="120.0dp"
                      android:scaleType="fitCenter"
                      android:src="@drawable/activity_0101" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textview6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:text="Navigation Drawer"
                    android:textColor="@color/text_slate_900"
                    android:textSize="14.0sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dp"
                    android:gravity="center"
                    android:text="Side sliding Drawer navigation"
                    android:textColor="@color/text_slate_500"
                    android:textSize="11.0sp" />
              </LinearLayout>

              <View
                  android:layout_width="8.0dp"
                  android:layout_height="wrap_content" />

              <!-- Template 4: Fullscreen App -->
              <LinearLayout
                  android:id="@+id/template_4_button"
                  android:layout_width="0.0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:clickable="true"
                  android:focusable="true"
                  android:gravity="center"
                  android:orientation="vertical"
                  android:padding="10.0dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16.0dp"
                    app:cardElevation="3.0dp"
                    app:contentPadding="4.0dp">
                  <ImageView
                      android:id="@+id/imageview2"
                      android:layout_width="match_parent"
                      android:layout_height="120.0dp"
                      android:scaleType="fitCenter"
                      android:src="@drawable/activity_0010" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textview7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:text="Fullscreen App"
                    android:textColor="@color/text_slate_900"
                    android:textSize="14.0sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dp"
                    android:gravity="center"
                    android:text="Immersive fullscreen without toolbar"
                    android:textColor="@color/text_slate_500"
                    android:textSize="11.0sp" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <!-- STEP 2: CONFIGURE PROJECT -->
        <LinearLayout
            android:id="@+id/application_info_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="8.0dp"
              app:cardBackgroundColor="@color/bg_white"
              app:cardCornerRadius="16.0dp"
              app:cardElevation="2.0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20.0dp">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="4.0dp"
                  android:text="Configure Project"
                  android:textColor="@color/text_slate_900"
                  android:textSize="18.0sp"
                  android:textStyle="bold" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="20.0dp"
                  android:text="Enter settings to create your new application project."
                  android:textColor="@color/text_slate_500"
                  android:textSize="13.0sp" />

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="16.0dp"
                  android:gravity="center_vertical"
                  android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/logo_card"
                    android:layout_width="64.0dp"
                    android:layout_height="64.0dp"
                    android:layout_marginRight="16.0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12.0dp"
                    app:cardElevation="2.0dp">
                  <ImageView
                      android:id="@+id/logo_preview"
                      android:layout_width="match_parent"
                      android:layout_height="match_parent"
                      android:scaleType="centerCrop"
                      android:src="@drawable/default_image" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="App Icon (Optional)"
                      android:textColor="@color/text_slate_900"
                      android:textSize="14.0sp"
                      android:textStyle="bold" />
                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Tap icon to choose custom logo"
                      android:textColor="@color/text_slate_500"
                      android:textSize="11.0sp" />
                </LinearLayout>
              </LinearLayout>

              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/textinputlayout1"
                  style="@style/TextInputLayoutStyle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="12.0dp"
                  app:boxStrokeColor="@color/colorPrimary"
                  app:hintTextColor="@color/colorPrimary">
                <EditText
                    android:id="@+id/edittext1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Application Name"
                    android:imeOptions="actionNext"
                    android:padding="12.0dp"
                    android:singleLine="true"
                    android:textColor="@color/text_slate_900"
                    android:textColorHint="@color/text_slate_400"
                    android:textSize="15.0sp" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/textinputlayout2"
                  style="@style/TextInputLayoutStyle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="12.0dp"
                  app:boxStrokeColor="@color/colorPrimary"
                  app:hintTextColor="@color/colorPrimary">
                <EditText
                    android:id="@+id/edittext2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Package Name (e.g. com.example.app)"
                    android:imeOptions="actionNext"
                    android:padding="12.0dp"
                    android:singleLine="true"
                    android:textColor="@color/text_slate_900"
                    android:textColorHint="@color/text_slate_400"
                    android:textSize="15.0sp" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/textinputlayout_minsdk"
                  style="@style/TextInputLayoutStyle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="12.0dp"
                  app:boxStrokeColor="@color/colorPrimary"
                  app:hintTextColor="@color/colorPrimary">
                <EditText
                    android:id="@+id/edittext_minsdk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Minimum SDK (Default: 21)"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:padding="12.0dp"
                    android:singleLine="true"
                    android:text="21"
                    android:textColor="@color/text_slate_900"
                    android:textColorHint="@color/text_slate_400"
                    android:textSize="15.0sp" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/textinputlayout_targetsdk"
                  style="@style/TextInputLayoutStyle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="12.0dp"
                  app:boxStrokeColor="@color/colorPrimary"
                  app:hintTextColor="@color/colorPrimary">
                <EditText
                    android:id="@+id/edittext_targetsdk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Target SDK (Default: 34)"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:padding="12.0dp"
                    android:singleLine="true"
                    android:text="34"
                    android:textColor="@color/text_slate_900"
                    android:textColorHint="@color/text_slate_400"
                    android:textSize="15.0sp" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/textinputlayout3"
                  style="@style/TextInputLayoutStyle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="12.0dp">
                <EditText
                    android:id="@+id/edittext3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:hint="Save Location"
                    android:padding="12.0dp"
                    android:text="/storage/emulated/0/.BUILD STUDIO/"
                    android:textColor="@color/text_slate_500"
                    android:textColorHint="@color/text_slate_400"
                    android:textSize="14.0sp" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  android:id="@+id/textinputlayout4"
                  style="@style/TextInputLayoutStyle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/edittext4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:hint="Programming Language"
                    android:padding="12.0dp"
                    android:text="Java"
                    android:textColor="@color/text_slate_500"
                    android:textColorHint="@color/text_slate_400"
                    android:textSize="14.0sp" />
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
          </androidx.cardview.widget.CardView>
        </LinearLayout>

      </LinearLayout>
    </ScrollView>

    <!-- BOTTOM BAR: EXIT / PREVIOUS & NEXT / CREATE -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12.0dp">

      <TextView
          android:id="@+id/TV_EXIT_PREVIOUS"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="?android:attr/selectableItemBackground"
          android:clickable="true"
          android:focusable="true"
          android:padding="12.0dp"
          android:text="EXIT"
          android:textColor="@color/text_slate_600"
          android:textSize="15.0sp"
          android:textStyle="bold" />

      <View
          android:layout_width="0.0dp"
          android:layout_height="1dp"
          android:layout_weight="1" />

      <LinearLayout
          android:id="@+id/create_btn"
          android:layout_width="120.0dp"
          android:layout_height="46.0dp"
          android:background="@drawable/btn_primary"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:orientation="horizontal">
        <TextView
            android:id="@+id/textview5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:textSize="15.0sp"
            android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>
</LinearLayout>