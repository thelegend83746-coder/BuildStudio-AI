<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical">

  <!-- Drawer Header -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="@color/bg_white"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingLeft="16dp"
      android:paddingRight="12dp">

    <TextView
        android:id="@+id/tv_drawer_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Project Files"
        android:textColor="@color/text_slate_900"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Quick New File button -->
    <ImageView
        android:id="@+id/btn_drawer_new_file"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="New File"
        android:scaleType="centerInside"
        android:src="@drawable/ic_insert_drive_file_grey"
        app:tint="@color/colorPrimary" />

    <!-- Quick New Folder button -->
    <ImageView
        android:id="@+id/btn_drawer_new_folder"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="New Folder"
        android:scaleType="centerInside"
        android:src="@drawable/ic_folder_black"
        app:tint="@color/colorPrimary" />

    <!-- Refresh Tree button -->
    <ImageView
        android:id="@+id/btn_drawer_refresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Refresh Tree"
        android:scaleType="centerInside"
        android:src="@drawable/round_select_all_20"
        app:tint="@color/colorPrimary" />
  </LinearLayout>

  <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="#E2E8F0" />

  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/recyclerview1"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:padding="4dp" />
</LinearLayout>