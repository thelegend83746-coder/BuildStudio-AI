<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <androidx.coordinatorlayout.widget.CoordinatorLayout
      android:id="@+id/_coordinator"
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

      <!-- Top Action Toolbar -->
      <LinearLayout
          android:id="@+id/toolbar"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:background="@color/bg_white"
          android:elevation="3dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="4dp"
          android:paddingEnd="4dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/drawer_toggle_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_black"
            app:tint="@color/text_slate_900" />

        <!-- Title: Project & Active File Name -->
        <TextView
            android:id="@+id/prj_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="Build Studio"
            android:textColor="@color/text_slate_900"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Undo Button -->
        <ImageView
            android:id="@+id/undo_btn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="1dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Undo"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_undo"
            app:tint="@color/text_slate_900" />

        <!-- Redo Button -->
        <ImageView
            android:id="@+id/redo_btn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="1dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Redo"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_redo"
            app:tint="@color/text_slate_900" />

        <!-- Save Button -->
        <ImageView
            android:id="@+id/btn_save"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="1dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Save File"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_save"
            app:tint="@color/colorPrimary" />

        <!-- Folder / Drawer Toggle Button -->
        <ImageView
            android:id="@+id/imageview3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="3dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Project Files"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_folder_black"
            app:tint="@color/colorPrimary" />

        <!-- Run / Build Button -->
        <LinearLayout
            android:id="@+id/Build"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/btn_run_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

          <ImageView
              android:layout_width="14dp"
              android:layout_height="14dp"
              android:layout_marginEnd="3dp"
              android:scaleType="fitCenter"
              android:src="@drawable/ic_play_arrow_black"
              app:tint="@android:color/white" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Run"
              android:textColor="#ffffff"
              android:textSize="12sp"
              android:textStyle="bold" />
        </LinearLayout>

        <!-- More Popup Menu Button -->
        <ImageView
            android:id="@+id/menu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="More Options"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert_black"
            app:tint="@color/text_slate_900" />
      </LinearLayout>

      <!-- Active File Tabs Bar -->
      <com.google.android.material.tabs.TabLayout
          android:id="@+id/tablayout1"
          android:layout_width="match_parent"
          android:layout_height="36dp"
          android:background="@color/bg_white"
          android:elevation="2dp"
          app:tabIndicatorColor="#E53935"
          app:tabIndicatorFullWidth="false"
          app:tabIndicatorHeight="3dp"
          app:tabMode="scrollable"
          app:tabSelectedTextColor="#E53935"
          app:tabTextColor="@color/text_slate_700" />

      <!-- FrameLayout Container for CodeEditor (Prevents InflateException Crash) -->
      <FrameLayout
          android:id="@+id/editor_container"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:background="#ffffff" />

      <!-- Quick Symbol / Code Assist Toolbar -->
      <com.apk.builder.SymbolLayout
          android:id="@+id/symbol_layout"
          android:layout_width="match_parent"
          android:layout_height="40dp" />

    </LinearLayout>
  </androidx.coordinatorlayout.widget.CoordinatorLayout>

  <!-- Side Navigation Drawer for Project File Tree -->
  <LinearLayout
      android:id="@+id/_nav_view"
      android:layout_width="300dp"
      android:layout_height="match_parent"
      android:layout_gravity="start"
      android:background="@color/bg_white"
      android:orientation="vertical">

    <include
        android:id="@+id/drawer"
        layout="@layout/_drawer_editor" />
  </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>