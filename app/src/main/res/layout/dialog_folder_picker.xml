<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_white"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Project Folder"
        android:textColor="@color/text_slate_900"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Current path display & Up button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#F1F5F9"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btn_folder_up"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_black"
            app:tint="@color/colorPrimary"
            android:contentDescription="Parent Directory" />

        <TextView
            android:id="@+id/tv_current_folder_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:singleLine="true"
            android:text="/storage/emulated/0"
            android:textColor="@color/text_slate_800"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Folder list -->
    <ListView
        android:id="@+id/lv_folders"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/tv_empty_folders"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center"
        android:text="No subfolders found"
        android:textColor="@color/text_slate_400"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_open_system_picker"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="System Picker"
            android:textColor="@color/colorPrimary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_cancel_folder_picker"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:text="Cancel"
            android:textColor="@color/text_slate_600"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_select_this_folder"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="Select This Folder"
            android:textColor="@color/bg_white"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
