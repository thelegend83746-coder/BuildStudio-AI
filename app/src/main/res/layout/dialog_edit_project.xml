<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/bg_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Project"
            android:textColor="@color/text_slate_900"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Edit app details, SDK versions, and application icon"
            android:textColor="@color/text_slate_500"
            android:textSize="13sp" />

        <!-- App Icon Picker Section -->
        <LinearLayout
            android:id="@+id/layout_edit_icon_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_round_card"
            android:backgroundTint="#F8FAFC"
            android:clickable="true"
            android:focusable="true">

            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <ImageView
                    android:id="@+id/iv_edit_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Icon"
                    android:textColor="@color/text_slate_900"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_edit_icon_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to change (Strict PNG required)"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_card"
                android:backgroundTint="#EEF2FF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="Choose"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- App Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_app_name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="App Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="@color/text_slate_900" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Package Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_package_name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Package Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_package_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/text_slate_900" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SDK Versions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Min SDK -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_edit_min_sdk"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Min SDK">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_min_sdk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="@color/text_slate_900" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Target SDK -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_edit_target_sdk"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Target SDK">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_target_sdk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="@color/text_slate_900" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Version Code and Version Name Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Version Code -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_edit_version_code"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Version Code">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_version_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="@color/text_slate_900" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Version Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_edit_version_name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Version Name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_edit_version_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_slate_900" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_config"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textColor="@color/text_slate_600" />

            <Button
                android:id="@+id/btn_save_config"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="Save Changes"
                android:textColor="@color/bg_white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
