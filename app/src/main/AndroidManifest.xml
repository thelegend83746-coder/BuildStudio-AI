<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.build.studio">

    <!-- Permissions for local Android IDE operations, network AI, and package installs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name="com.apk.builder.ApplicationLoader"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="BUILD STUDIO"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuildStudio.CyberDark"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true">

        <!-- Splash Activity (Launcher Entry Point) -->
        <activity
            android:name="com.build.studio.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BuildStudio.CyberDark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Projects Dashboard -->
        <activity
            android:name="com.build.studio.ProjectListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <!-- Project Creation Wizard -->
        <activity
            android:name="com.build.studio.CreateProjectActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <!-- High-Performance Code Editor -->
        <activity
            android:name="com.build.studio.EditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <!-- Build Studio AI Assistant Screen -->
        <activity
            android:name="com.build.studio.BuildAiActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <!-- Settings Activities matching exact APK layouts -->
        <activity
            android:name="com.build.studio.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.build.studio.ApplicationSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.build.studio.EditorSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.build.studio.BuildRunSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.build.studio.AboutPageActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.build.studio.AboutUsActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.build.studio.SettingsMenuActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.build.studio.OllamaSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.build.studio.BuildSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <!-- Compatibility Aliases for apk.builder namespace -->
        <activity
            android:name="com.apk.builder.SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.apk.builder.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.apk.builder.CreateProjectActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.apk.builder.CodeEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <activity
            android:name="com.apk.builder.SettingActivity"
            android:exported="false"
            android:theme="@style/Theme.BuildStudio.CyberDark" />

        <!-- Background Build Service -->
        <service
            android:name="com.apk.builder.BuildService"
            android:exported="false" />

        <!-- FileProvider for APK Installation Dispatches -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.build.studio.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider" />
        </provider>

    </application>

</manifest>
